// Deploy contract for the Workers runtime (celld), the prod environment.
// Public values only: a secret or an internal address never enters this file.
{
  "name": "prep",
  "main": "runtime/worker.ts",
  "compatibility_date": "2026-01-01",
  "durable_objects": {
    "bindings": [
      { "name": "USER", "class_name": "UserCell" },
      { "name": "DIRECTORY", "class_name": "DirectoryCell" },
      { "name": "INSTANT_LIMITER", "class_name": "InstantLimiterCell" },
      { "name": "JOB", "class_name": "JobCell" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserCell", "DirectoryCell", "InstantLimiterCell", "JobCell"] }
  ],
  "assets": { "directory": "dist/assets", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "PREP_ENV": "prod",
    // Clerk's public configuration. The secret key, the webhook secret and
    // every other credential arrive as CELLD_VAR_*, never from this file.
    "CLERK_ISSUER": "https://clerk.prepcards.app",
    "CLERK_JWKS_URL": "https://clerk.prepcards.app/.well-known/jwks.json",
    "CLERK_ACCOUNTS_URL": "https://accounts.prepcards.app",
    "CLERK_AUTHORIZED_PARTIES": "https://prepcards.app",
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsucHJlcGNhcmRzLmFwcCQ"
  }
}
