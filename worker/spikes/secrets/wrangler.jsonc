// Spike 1: which node-side mechanism delivers a value into env that is
// NOT committed here. PUBLIC_VAR and OVERRIDE_ME are the committed baseline.
{
  "name": "spike-secrets",
  "main": "src/worker.ts",
  "compatibility_date": "2026-01-01",
  "durable_objects": { "bindings": [{ "name": "PROBE", "class_name": "ProbeCell" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProbeCell"] }],
  "vars": { "PUBLIC_VAR": "committed-in-wrangler", "OVERRIDE_ME": "wrangler-value" }
}
