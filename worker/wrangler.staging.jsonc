// Deploy contract for the Workers runtime (celld), the staging environment.
// Public values only: a secret or an internal address never enters this file.
{
  "name": "prep",
  "main": "runtime/worker.ts",
  "compatibility_date": "2026-01-01",
  "durable_objects": {
    "bindings": [
      { "name": "USER", "class_name": "UserCell" },
      { "name": "DIRECTORY", "class_name": "DirectoryCell" },
      { "name": "INSTANT_LIMITER", "class_name": "InstantLimiterCell" },
      { "name": "JOB", "class_name": "JobCell" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserCell", "DirectoryCell", "InstantLimiterCell", "JobCell"] }
  ],
  "assets": { "directory": "dist/assets", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "PREP_ENV": "staging",
    // The outbound fetch ceiling this deploy's celld node runs with; the
    // worker takes the smaller of it and PREP_JOB_LLM_TIMEOUT_S minus 5s of
    // headroom, so an LLM step gets its full 300s. Must match the node's own
    // CELLD_FETCH_TIMEOUT_S.
    "CELLD_FETCH_TIMEOUT_S": "330",
    // Clerk's public configuration. The secret key, the webhook secret and
    // every other credential arrive as CELLD_VAR_*, never from this file.
    "CLERK_ISSUER": "https://perfect-bengal-99.clerk.accounts.dev",
    "CLERK_JWKS_URL": "https://perfect-bengal-99.clerk.accounts.dev/.well-known/jwks.json",
    "CLERK_ACCOUNTS_URL": "https://perfect-bengal-99.accounts.dev",
    "CLERK_AUTHORIZED_PARTIES": "https://staging.prepcards.app,https://celld.staging.prepcards.app",
    "CLERK_PUBLISHABLE_KEY": "pk_test_cGVyZmVjdC1iZW5nYWwtOTkuY2xlcmsuYWNjb3VudHMuZGV2JA"
  }
}
