# Optional per-deploy overrides for `docker compose up`.
#
# `docker compose up -d` works out of the box without this file — every
# variable below has a sensible default in compose.yml. Copy to .env
# and edit only the things you actually want to change.
#
#   cp .env.example .env && $EDITOR .env

# Auth bypass. When set (and non-empty), every header-less request
# becomes this user. Default is `guest` so a fresh `docker compose up`
# is single-user-usable with zero config.
#
# The only multi-user auth path prep offers is Tailscale Serve — it
# injects per-user identity headers (Tailscale-User-Login) that prep
# maps to user_id, and those headers always win over this bypass.
#
# To run multi-user behind tailscale, set this to empty here so the
# header-less path returns 401 instead of silently becoming `guest`.
# PREP_DEFAULT_USER=

# URL prefix the app generates. Empty = serves at root (good for
# direct-port access). Set to /prep (or whatever) when path-mounting
# behind tailscale serve --set-path or another reverse proxy.
# ROOT_PATH=

# Host port the prep app listens on. The container always binds 8082
# internally; this is the host-side port mapped to it. Default: 8082.
# PREP_HOST_PORT=8082

# Volume namespace. The compose names data volumes `${ENV_NAME}-data`
# and `${ENV_NAME}-agent-data`. Only matters if you run two prep
# stacks on the same docker host — staging + prod, dev + prod, etc.
# Default: 'prep'.
# ENV_NAME=prep

# Internal temporal namespace. Different stacks on the same host
# should differ; a single deployment can use anything. Default: 'prep'.
# TEMPORAL_NAMESPACE=prep

# IANA "sub" claim sent to push services on web push notifications.
# Recommended in production so a push provider can reach the operator
# if there's an operational issue.
# PREP_VAPID_SUB=mailto:you@example.com

# Free inference tier (optional; see docs/AI-PROVIDERS.md). A
# deploy-wide OpenAI-compatible endpoint that serves AI features for
# users without their own key. Enabled iff the first three are all
# set; all unset = feature off. BYOK always wins over it.
# PREP_FREE_INFERENCE_BASE_URL=
# PREP_FREE_INFERENCE_API_KEY=
# PREP_FREE_INFERENCE_MODEL=
# Optional JSON object merged into every request body (sampler /
# reasoning knobs), e.g. {"chat_template_kwargs": {"enable_thinking": false}}
# PREP_FREE_INFERENCE_EXTRA_BODY=

# Anonymous instant generation (POST /api/instant/generate; see
# docs/INSTANT-START.md). Serves only when the free tier above is
# configured. All knobs optional; defaults shown.
#
# Header the trusted ingress sets with the real client IP; the rate
# limiter keys on it and fails closed to a shared bucket when the
# header is missing or not an IP (it never trusts the socket peer).
# The special value `x-forwarded-for-last` selects the LAST
# X-Forwarded-For entry, for ingresses that append rather than
# overwrite.
# PREP_CLIENT_IP_HEADER=x-real-ip

# Per-IP burst: attempts admitted per window, counting every attempt
# whatever its outcome.
# PREP_INSTANT_BURST_LIMIT=1
# PREP_INSTANT_BURST_WINDOW_S=60

# Per-IP daily allowance; counts every attempt that spent upstream
# tokens, successful or not, plus in-flight calls.
# PREP_INSTANT_PER_IP_PER_DAY=3

# Deploy-wide daily circuit breaker on token-spending attempts; caps
# the endpoint's share of the free tier's daily quota.
# PREP_INSTANT_GLOBAL_PER_DAY=200

# Deploy-wide per-minute cap on token-spending attempts; rations the
# free tier's per-minute token budget so bursts can't starve
# signed-in AI features.
# PREP_INSTANT_GLOBAL_PER_MINUTE=4

# Output-token cap per instant generation call; bounds worst-case
# spend per request (roughly 4x an honest 5-card deck).
# PREP_INSTANT_MAX_OUTPUT_TOKENS=1024
