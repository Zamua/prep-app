{
 "description": "Shared markdown cases for the card-prompt renderer. Each case is {id, input, expected}. Two implementations must produce `expected` for every input: the server renderer (worker/domain/markdown) and its browser twin (static/js/study/markdown.js). The file is their contract; changing an expected value means changing both.",
 "cases": [
  {
   "id": "plain-question",
   "input": "Capital of France?",
   "expected": "<p>Capital of France?</p>\n"
  },
  {
   "id": "two-paragraphs",
   "input": "First the setup.\n\nThen the actual question?",
   "expected": "<p>First the setup.</p>\n<p>Then the actual question?</p>\n"
  },
  {
   "id": "soft-wrap",
   "input": "line one\nline two soft-wrapped",
   "expected": "<p>line one\nline two soft-wrapped</p>\n"
  },
  {
   "id": "hard-break",
   "input": "line one  \nline two after a hard break",
   "expected": "<p>line one<br />\nline two after a hard break</p>\n"
  },
  {
   "id": "bold-term",
   "input": "What does **TCP** guarantee that UDP does not?",
   "expected": "<p>What does <strong>TCP</strong> guarantee that UDP does not?</p>\n"
  },
  {
   "id": "bold-underscore",
   "input": "__dunder bold__ term",
   "expected": "<p><strong>dunder bold</strong> term</p>\n"
  },
  {
   "id": "italic-star",
   "input": "Define *idempotent* in one sentence.",
   "expected": "<p>Define <em>idempotent</em> in one sentence.</p>\n"
  },
  {
   "id": "italic-underscore",
   "input": "Define _referential transparency_ briefly.",
   "expected": "<p>Define <em>referential transparency</em> briefly.</p>\n"
  },
  {
   "id": "em-strong-triple",
   "input": "This is ***really important*** to know.",
   "expected": "<p>This is <em><strong>really important</strong></em> to know.</p>\n"
  },
  {
   "id": "strikethrough",
   "input": "The old name was ~~master~~ main.",
   "expected": "<p>The old name was <del>master</del> main.</p>\n"
  },
  {
   "id": "strike-with-bold",
   "input": "~~strike with **bold** inside~~",
   "expected": "<p><del>strike with <strong>bold</strong> inside</del></p>\n"
  },
  {
   "id": "inline-code",
   "input": "Explain `SELECT *` vs explicit columns",
   "expected": "<p>Explain <code>SELECT *</code> vs explicit columns</p>\n"
  },
  {
   "id": "inline-code-specials",
   "input": "What does `a < b && c > d` evaluate to?",
   "expected": "<p>What does <code>a &lt; b &amp;&amp; c &gt; d</code> evaluate to?</p>\n"
  },
  {
   "id": "inline-code-quotes",
   "input": "Why does `s = \"x\"` allocate?",
   "expected": "<p>Why does <code>s = &quot;x&quot;</code> allocate?</p>\n"
  },
  {
   "id": "double-tick-code",
   "input": "Quote a backtick: `` a`b `` inline",
   "expected": "<p>Quote a backtick: <code>a`b</code> inline</p>\n"
  },
  {
   "id": "code-span-space-trim",
   "input": "Padded ` x ` span",
   "expected": "<p>Padded <code>x</code> span</p>\n"
  },
  {
   "id": "bold-with-code",
   "input": "**bold with `code` inside**",
   "expected": "<p><strong>bold with <code>code</code> inside</strong></p>\n"
  },
  {
   "id": "em-with-code",
   "input": "*em with `code`*",
   "expected": "<p><em>em with <code>code</code></em></p>\n"
  },
  {
   "id": "fence-python",
   "input": "```python\ndef f(x):\n    return x * 2\n```\nWhat does f(3) return?",
   "expected": "<pre><code class=\"language-python\">def f(x):\n    return x * 2\n</code></pre>\n<p>What does f(3) return?</p>\n"
  },
  {
   "id": "fence-no-lang",
   "input": "```\nplain fence\n```",
   "expected": "<pre><code>plain fence\n</code></pre>\n"
  },
  {
   "id": "fence-specials",
   "input": "```\nif (a < b && c > d) { s = \"x\"; }\n```",
   "expected": "<pre><code>if (a &lt; b &amp;&amp; c &gt; d) { s = &quot;x&quot;; }\n</code></pre>\n"
  },
  {
   "id": "fence-xss",
   "input": "```python\n<script>alert(1)</script>\n```",
   "expected": "<pre><code class=\"language-python\">&lt;script&gt;alert(1)&lt;/script&gt;\n</code></pre>\n"
  },
  {
   "id": "fence-tilde",
   "input": "~~~\ntilde fence\n~~~",
   "expected": "<pre><code>tilde fence\n</code></pre>\n"
  },
  {
   "id": "fence-unterminated",
   "input": "```python\nunterminated fence",
   "expected": "<pre><code class=\"language-python\">unterminated fence\n</code></pre>\n"
  },
  {
   "id": "heading-h1",
   "input": "# Heading\nbody text",
   "expected": "<h1>Heading</h1>\n<p>body text</p>\n"
  },
  {
   "id": "heading-h2-inline",
   "input": "## Head **bold** `code`",
   "expected": "<h2>Head <strong>bold</strong> <code>code</code></h2>\n"
  },
  {
   "id": "heading-extra-spaces",
   "input": "#  Head with extra spaces  ",
   "expected": "<h1>Head with extra spaces</h1>\n"
  },
  {
   "id": "ul-flat",
   "input": "- one\n- two\n- three",
   "expected": "<ul>\n<li>one</li>\n<li>two</li>\n<li>three</li>\n</ul>\n"
  },
  {
   "id": "ul-inline-markdown",
   "input": "- item **bold**\n- item `code`",
   "expected": "<ul>\n<li>item <strong>bold</strong></li>\n<li>item <code>code</code></li>\n</ul>\n"
  },
  {
   "id": "ol-flat",
   "input": "1. first\n2. second",
   "expected": "<ol>\n<li>first</li>\n<li>second</li>\n</ol>\n"
  },
  {
   "id": "ol-start-3",
   "input": "3. third\n4. fourth",
   "expected": "<ol start=\"3\">\n<li>third</li>\n<li>fourth</li>\n</ol>\n"
  },
  {
   "id": "ol-repeated-1",
   "input": "1. first\n1. second\n1. third",
   "expected": "<ol>\n<li>first</li>\n<li>second</li>\n<li>third</li>\n</ol>\n"
  },
  {
   "id": "para-then-list",
   "input": "Explain **why** `fsync()` matters:\n\n1. durability\n2. ordering",
   "expected": "<p>Explain <strong>why</strong> <code>fsync()</code> matters:</p>\n<ol>\n<li>durability</li>\n<li>ordering</li>\n</ol>\n"
  },
  {
   "id": "list-interrupts-para",
   "input": "para intro\n- item one\n- item two",
   "expected": "<p>para intro</p>\n<ul>\n<li>item one</li>\n<li>item two</li>\n</ul>\n"
  },
  {
   "id": "list-then-para",
   "input": "- item one\n- item two\n\npara after",
   "expected": "<ul>\n<li>item one</li>\n<li>item two</li>\n</ul>\n<p>para after</p>\n"
  },
  {
   "id": "link-basic",
   "input": "[mdn docs](https://developer.mozilla.org/) inline link",
   "expected": "<p><a href=\"https://developer.mozilla.org/\">mdn docs</a> inline link</p>\n"
  },
  {
   "id": "link-in-list",
   "input": "- see [docs](https://ex.com/a?b=1&c=2)",
   "expected": "<ul>\n<li>see <a href=\"https://ex.com/a?b=1&amp;c=2\">docs</a></li>\n</ul>\n"
  },
  {
   "id": "link-bold-label",
   "input": "[**docs**](https://ex.com)",
   "expected": "<p><a href=\"https://ex.com\"><strong>docs</strong></a></p>\n"
  },
  {
   "id": "blockquote",
   "input": "> quoted wisdom\n> second line",
   "expected": "<blockquote>\n<p>quoted wisdom\nsecond line</p>\n</blockquote>\n"
  },
  {
   "id": "blockquote-then-para",
   "input": "> quote\n\nafter",
   "expected": "<blockquote>\n<p>quote</p>\n</blockquote>\n<p>after</p>\n"
  },
  {
   "id": "thematic-break",
   "input": "before\n\n---\n\nafter",
   "expected": "<p>before</p>\n<hr />\n<p>after</p>\n"
  },
  {
   "id": "xss-script-tag",
   "input": "<script>alert(1)</script>",
   "expected": "<p>&lt;script&gt;alert(1)&lt;/script&gt;</p>\n"
  },
  {
   "id": "xss-img-onerror",
   "input": "<img src=x onerror=\"alert(1)\">",
   "expected": "<p>&lt;img src=x onerror=&quot;alert(1)&quot;&gt;</p>\n"
  },
  {
   "id": "entities-plain",
   "input": "5 > 3 & 2 < 4 \"quotes\" 'single'",
   "expected": "<p>5 &gt; 3 &amp; 2 &lt; 4 &quot;quotes&quot; 'single'</p>\n"
  },
  {
   "id": "lone-markers-literal",
   "input": "text with * lone asterisk and _ underscore",
   "expected": "<p>text with * lone asterisk and _ underscore</p>\n"
  },
  {
   "id": "snake-case-literal",
   "input": "why does snake_case_name stay literal?",
   "expected": "<p>why does snake_case_name stay literal?</p>\n"
  },
  {
   "id": "unterminated-bold-literal",
   "input": "**unterminated bold",
   "expected": "<p>**unterminated bold</p>\n"
  },
  {
   "id": "hash-no-space-literal",
   "input": "#nospace",
   "expected": "<p>#nospace</p>\n"
  },
  {
   "id": "seven-hashes-literal",
   "input": "####### seven",
   "expected": "<p>####### seven</p>\n"
  },
  {
   "id": "mixed-inline",
   "input": "Compare `foo()` with **bar** and *baz*, then ~~drop~~ keep it.",
   "expected": "<p>Compare <code>foo()</code> with <strong>bar</strong> and <em>baz</em>, then <del>drop</del> keep it.</p>\n"
  },
  {
   "id": "table-pipe",
   "input": "| a | b |\n|---|---|\n| 1 | 2 |",
   "expected": "<table>\n<thead>\n<tr>\n  <th>a</th>\n  <th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n  <td>1</td>\n  <td>2</td>\n</tr>\n</tbody>\n</table>\n"
  },
  {
   "id": "xss-js-link",
   "input": "[click](javascript:alert(1))",
   "expected": "<p><a href=\"#harmful-link\">click</a></p>\n"
  },
  {
   "id": "empty-string",
   "input": "",
   "expected": ""
  },
  {
   "id": "image-basic",
   "input": "![alt](https://x.png)",
   "expected": "<p><img src=\"https://x.png\" alt=\"alt\" /></p>\n"
  },
  {
   "id": "setext-h2",
   "input": "Head\n-----",
   "expected": "<h2>Head</h2>\n"
  },
  {
   "id": "backslash-escape",
   "input": "\\*not em\\*",
   "expected": "<p>*not em*</p>\n"
  },
  {
   "id": "nested-list",
   "input": "- a\n  - b\n- c",
   "expected": "<ul>\n<li>a<ul>\n<li>b</li>\n</ul>\n</li>\n<li>c</li>\n</ul>\n"
  },
  {
   "id": "list-continuation",
   "input": "- item\n  continued",
   "expected": "<ul>\n<li>item\ncontinued</li>\n</ul>\n"
  },
  {
   "id": "lazy-quote-continuation",
   "input": "> a\nb",
   "expected": "<blockquote>\n<p>a\nb</p>\n</blockquote>\n"
  },
  {
   "id": "code-span-in-link-url",
   "input": "[x](https://a.com/`code`)",
   "expected": "<p><a href=\"https://a.com/%60code%60\">x</a></p>\n"
  },
  {
   "id": "table-aligned",
   "input": "| left | center | right |\n|:-----|:------:|------:|\n| a | b | c |",
   "expected": "<table>\n<thead>\n<tr>\n  <th style=\"text-align:left\">left</th>\n  <th style=\"text-align:center\">center</th>\n  <th style=\"text-align:right\">right</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n  <td style=\"text-align:left\">a</td>\n  <td style=\"text-align:center\">b</td>\n  <td style=\"text-align:right\">c</td>\n</tr>\n</tbody>\n</table>\n"
  },
  {
   "id": "list-loose",
   "input": "- one\n\n- two\n\n- three",
   "expected": "<ul>\n<li><p>one</p>\n</li>\n<li><p>two</p>\n</li>\n<li><p>three</p>\n</li>\n</ul>\n"
  },
  {
   "id": "indented-code",
   "input": "Setup:\n\n    x = 1\n    y = 2\n\nWhat is x + y?",
   "expected": "<p>Setup:</p>\n<pre><code>x = 1\ny = 2</code></pre>\n<p>What is x + y?</p>\n"
  },
  {
   "id": "link-mailto",
   "input": "Write to [support](mailto:help@example.com) first.",
   "expected": "<p>Write to <a href=\"mailto:help@example.com\">support</a> first.</p>\n"
  },
  {
   "id": "escaped-backtick",
   "input": "Type \\`ls\\` to list files.",
   "expected": "<p>Type `ls` to list files.</p>\n"
  },
  {
   "id": "image-data-png",
   "input": "![dot](data:image/png;base64,iVBORw0KGgo=)",
   "expected": "<p><img src=\"data:image/png;base64,iVBORw0KGgo=\" alt=\"dot\" /></p>\n"
  },
  {
   "id": "autolink",
   "input": "See <https://example.com/docs?a=1&b=2> for details.",
   "expected": "<p>See <a href=\"https://example.com/docs?a=1&amp;b=2\">https://example.com/docs?a=1&amp;b=2</a> for details.</p>\n"
  },
  {
   "id": "autolink-email",
   "input": "Contact <ops@example.com> now.",
   "expected": "<p>Contact <a href=\"mailto:ops@example.com\">ops@example.com</a> now.</p>\n"
  },
  {
   "id": "link-title",
   "input": "[spec](https://example.com \"The spec\") explains it.",
   "expected": "<p><a href=\"https://example.com\" title=\"The spec\">spec</a> explains it.</p>\n"
  },
  {
   "id": "reference-link",
   "input": "Read [the RFC][rfc] carefully.\n\n[rfc]: https://example.com/rfc \"RFC\"",
   "expected": "<p>Read <a href=\"https://example.com/rfc\" title=\"RFC\">the RFC</a> carefully.</p>\n"
  },
  {
   "id": "entity-in-url",
   "input": "[q](https://example.com/?a=1&amp;b=2&copy)",
   "expected": "<p><a href=\"https://example.com/?a=1&amp;b=2&amp;copy\">q</a></p>\n"
  },
  {
   "id": "block-html-escaped",
   "input": "<div class=\"box\">\n**not bold**\n</div>\n\nAfter.",
   "expected": "<p>&lt;div class=&quot;box&quot;&gt;\n**not bold**\n&lt;/div&gt;</p>\n<p>After.</p>\n"
  },
  {
   "id": "nested-emphasis",
   "input": "**bold *and italic* inside** plus *italic **and bold** inside*",
   "expected": "<p><strong>bold <em>and italic</em> inside</strong> plus <em>italic <strong>and bold</strong> inside</em></p>\n"
  },
  {
   "id": "blockquote-list",
   "input": "> Steps:\n> - one\n> - two",
   "expected": "<blockquote>\n<p>Steps:</p>\n<ul>\n<li>one</li>\n<li>two</li>\n</ul>\n</blockquote>\n"
  },
  {
   "id": "ordered-nested-loose",
   "input": "1. first\n\n   details\n\n2. second",
   "expected": "<ol>\n<li><p>first</p>\n<p>details</p>\n</li>\n<li><p>second</p>\n</li>\n</ol>\n"
  },
  {
   "id": "table-inline",
   "input": "| term | note |\n|---|---|\n| `fsync` | **flushes** to disk |",
   "expected": "<table>\n<thead>\n<tr>\n  <th>term</th>\n  <th>note</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n  <td><code>fsync</code></td>\n  <td><strong>flushes</strong> to disk</td>\n</tr>\n</tbody>\n</table>\n"
  },
  {
   "id": "hard-break-backslash",
   "input": "line one\\\nline two",
   "expected": "<p>line one<br />\nline two</p>\n"
  },
  {
   "id": "thematic-break-stars",
   "input": "before\n\n* * *\n\nafter",
   "expected": "<p>before</p>\n<hr />\n<p>after</p>\n"
  }
 ]
}
