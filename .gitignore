# Worker build output: generated by `npm run build`, never committed
worker/build/
worker/dist/
node_modules/

# SQLite: local node state
*.sqlite
*.sqlite-shm
*.sqlite-wal

# CodeMirror bundle build inputs: static/cm-bundle.js ships, its
# node_modules does not.
static/cm/node_modules/

# Local secrets and per-deployment state. Never committed: this repo is
# public, and the VAPID private key is a real credential.
.env
vapid-keys.json
vapid-private.pem
push-subscriptions.json
push-subscriptions.json.archived-*

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp

# Local run output
artifacts/

# Agent scratch: worktrees and session state, never part of the app
.claude/
